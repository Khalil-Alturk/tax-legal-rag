# Copy to .env and fill in. Never commit .env.
GOOGLE_API_KEY=your-google-ai-studio-key

# Model names: change here without touching code.
# See https://ai.google.dev/gemini-api/docs/models
LLM_MODEL=gemini-3.8-flash
EMBEDDING_MODEL=gemini-embedding-001
# Optional. Leave unset for the model default (Gemini 3.x recommends 1.0).
# LLM_TEMPERATURE=

# Storage
DATA_DIR=data
CHROMA_DIR=chroma_db
COLLECTION_NAME=tax_legal_docs

# Chunking (characters, tuned for Arabic + English legal text)
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Retrieval
DEFAULT_TOP_K=4
MAX_TOP_K=20

# Embedding batches (free-tier friendly)
EMBED_BATCH_SIZE=20
EMBED_MAX_RETRIES=5

# Upload limit
MAX_UPLOAD_MB=10

LOG_LEVEL=INFO
